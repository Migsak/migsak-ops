# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Time zone used for "today", daily totals and weekly targets.
APP_TIMEZONE=Asia/Kolkata

# GitHub commit tracking
# Fine-grained personal access token with read-only "Contents" and "Metadata"
# access to the repositories you want to track.
GITHUB_TOKEN=
# Random string. Use the same value as the webhook secret in each repo's webhook settings.
GITHUB_WEBHOOK_SECRET=

# Random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
